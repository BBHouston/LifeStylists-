# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# ──────────────────────────────────────────────────────────────────────────────
# SOLANA / PUMP.FUN
# ──────────────────────────────────────────────────────────────────────────────
# Paste your $LIFE token mint address here after creating it on Pump.fun.
LIFE_MINT_ADDRESS=

# Helius RPC API key — free 100k requests/day tier:
#   https://www.helius.dev/ → Sign up → Create API Key
HELIUS_API_KEY=

# ──────────────────────────────────────────────────────────────────────────────
# SOCIAL / SENTIMENT
# ──────────────────────────────────────────────────────────────────────────────
# Twitter/X Bearer Token — free Basic tier (10k tweets/month):
#   https://developer.twitter.com/en/portal/dashboard
#   → Create App → Keys and Tokens → Bearer Token
TWITTER_BEARER_TOKEN=

# Telegram Bot Token — get from @BotFather on Telegram:
#   Open Telegram → search @BotFather → /newbot → copy the token
TELEGRAM_BOT_TOKEN=

# Your $LIFE Telegram channel ID (starts with -100 for public channels).
#   Add your bot as admin, then call:
#   https://api.telegram.org/bot<TOKEN>/getChat?chat_id=@your_channel
TELEGRAM_CHANNEL_ID=

# ──────────────────────────────────────────────────────────────────────────────
# ALERTS — SLACK & DISCORD
# ──────────────────────────────────────────────────────────────────────────────
# Slack Incoming Webhook URL:
#   https://api.slack.com/messaging/webhooks
#   → Your Workspace → Apps → Incoming Webhooks → Add → Copy URL
SLACK_WEBHOOK_URL=

# Discord Webhook URL:
#   Discord server → Channel Settings → Integrations → Webhooks → New Webhook → Copy URL
DISCORD_WEBHOOK_URL=

# ──────────────────────────────────────────────────────────────────────────────
# AI (OPTIONAL) — Claude-powered sentiment analysis
# ──────────────────────────────────────────────────────────────────────────────
# Anthropic API key for AI-powered crypto sentiment scoring:
#   https://console.anthropic.com/ → API Keys
ANTHROPIC_API_KEY=
